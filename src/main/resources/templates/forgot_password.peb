{% extends "layout" %}
{% import "fragments/input" %}

{% block title %}Forgot your password?{% endblock %}
{% block pageHeader %}Forgotten password{% endblock %}

{% block content %}
<div>
    <form name='forgotPasswordForm' class="space-y-6" action="{{ href('/user/forgot_password') }}" method="POST">
        {{ errorableInput(type='email', name='email', id='email', autocomplete='email', labelText='Email address', required='true', formName='forgotPasswordForm') }}
        {% include 'fragments/csrf' %}
        
        <div>
            <button type="submit"
                    class="flex w-full justify-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                Send password reset email
            </button>
        </div>
    </form>
    
    <div class="mt-10 flex flex-col gap-y-4 text-center text-sm/6 text-gray-500">
        <p>
            Remember your password? <a href="/login" class="font-semibold text-indigo-600 hover:text-indigo-500">Log in
            here</a>
        </p>
    </div>
</div>
{% endblock %}
