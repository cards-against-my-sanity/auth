{% macro checkbox(name, id, labelText, checked=false) %}
<div>
    <label for="{{ id }}" class="block text-sm/6 font-medium text-gray-900">{{ labelText }}</label>
    <div class="mt-2">
        <!--suppress HtmlFormInputWithoutLabel -->
        <input type="checkbox" name="{{ name }}" id="{{ id }}" {{ checked ? 'checked' : '' }} class="block rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" />
    </div>
</div>
{% endmacro %}
