{# @pebvariable name="alert" type="dev.jacobandersen.cams.auth.model.template.Alert" #}
{# @pebvariable name="name" type="String" #}
{# @pebvariable name="message" type="String" #}

{% if alert != null %}
    {% set name = alert.type().name() %}
    {% set message = alert.message() %}

    <div class="border-l-4 p-4 mb-6 {{ name == 'SUCCESS' ? 'border-green-400 bg-green-50' : name == 'ERROR' ?'border-red-400 bg-red-50' : name == 'INFO' ? 'border-blue-400 bg-blue-50' : '' }}">
        <div class="flex">
            <div class="shrink-0">
                <div>
                    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
                         data-slot="icon"
                         class="size-5 {{ name == 'SUCCESS' ? 'text-green-400' : name == 'ERROR' ? 'text-red-400' : name == 'INFO' ? 'text-blue-400' : '' }}">
                        {% if name == 'SUCCESS' %}
                        <path fill-rule="evenodd"
                              d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"></path>
                        {% elseif name == 'ERROR' %}
                        <path fill-rule="evenodd"
                              d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z"
                              clip-rule="evenodd"></path>
                        {% elseif name == 'INFO' %}
                         <path fill-rule="evenodd"
                              d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z"
                              clip-rule="evenodd"></path>
                        {% endif %}
                   </svg>
                </div>
            </div>
            <div class="ml-3">
                <p class="text-sm {{ name == 'SUCCESS' ? 'text-green-700' : name == 'ERROR' ? 'text-red-700' : name == 'INFO' ? 'text-blue-700' : '' }}">{{ message | raw }}</p>
            </div>
        </div>
    </div>
{% endif %}
