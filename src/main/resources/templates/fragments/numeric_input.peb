{% macro numericInput(name, id, initialValue, min, max, labelText, required='false') %}
<div>
    <label for="{{id}}" class="block text-sm/6 font-medium text-gray-900">{{ labelText }}</label>
    <div class="mt-2">
        <!--suppress HtmlFormInputWithoutLabel -->
        <input type="number" name="{{name}}" id="{{ id }}" min="{{ min }}" max="{{ max }}" value="{{ initialValue }}" required="{{ required }}"
               class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" />
    </div>
</div>
{% endmacro %}

{% macro errorableNumericInput(name, id, initialValue, min, max, labelText, required='false', formName) %}
    {{ numericInput(name, id, initialValue, min, max, labelText, required) }}
    {% if hasFieldErrors(formName, name) %}
        {% for err in getFieldErrors(formName, name) %}
            <div class="text-xs text-red-400">{{ err }}</div>
        {% endfor %}
    {% endif %}
{% endmacro %}