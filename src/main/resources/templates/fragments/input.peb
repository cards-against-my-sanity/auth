{% macro input(type="text", name, id, autocomplete="off", labelText, required=false, extraClass='', initialValue='') %}
<div>
    <label for="{{ id }}" class="block text-sm/6 font-medium text-gray-900">{{ labelText }}</label>
    <div class="mt-2">
        <input type="{{ type }}" name="{{ name }}" id="{{ id }}" autocomplete="{{ autocomplete }}" required="{{ required }}" value="{{ initialValue }}"
               class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 {{ extraClass }}">
    </div>
</div>
{% endmacro %}

{% macro errorableInput(type="text", name, id, autocomplete="off", labelText, required=false, extraClass='', initialValue='', formName='') %}
    {{ input(type, name, id, autocomplete, labelText, required, extraClass, initialValue) }}
    {% if hasFieldErrors(formName, name) %}
        {% for err in getFieldErrors(formName, name) %}
            <div class="text-xs text-red-400">{{ err }}</div>
        {% endfor %}
    {% endif %}
{% endmacro %}
