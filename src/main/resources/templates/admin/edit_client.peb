{# @pebvariable name="registeredClient" type="org.springframework.security.oauth2.server.authorization.client.RegisteredClient" #}

{% extends "admin/admin_layout" %}

{% import "../fragments/input" %}
{% import "../fragments/numeric_input" %}
{% import "../fragments/checkbox" %}

{% block title %}{{ registeredClient.clientName }} - Edit OAuth Client{% endblock %}
{% block pageHeader %}{{ registeredClient.clientName }} - Edit OAuth Client{% endblock %}

{% block extraHead %}
<link href="https://cdn.jsdelivr.net/npm/@yaireo/tagify/dist/tagify.css" rel="stylesheet" type="text/css"/>
<script src="https://cdn.jsdelivr.net/npm/@yaireo/tagify"></script>
<script src="https://cdn.jsdelivr.net/npm/@yaireo/tagify/dist/tagify.polyfills.min.js"></script>
{% endblock %}

{% block content %}
<div>
    <form name='addClientForm' class="space-y-6" action="{{ href('/admin/oauth/clients/' + registeredClient.id + '/edit') }}" method="POST">
        {{ errorableInput(type='text', name='clientName', id='clientName', autocomplete='off', labelText='Client Name', required='true', initialValue=registeredClient.clientName, formName='addClientForm') }}
        {{ errorableInput(type='text', name='clientAuthenticationMethods', id='clientAuthenticationMethods', autocomplete='off', labelText='Client Authentication Method(s)', required='true', extraClass='tagify--custom-dropdown', initialValue=rcClientAuthMethodsCsv, formName='addClientForm') }}
        {{ errorableInput(type='text', name='authorizationGrantTypes', id='authorizationGrantTypes', autocomplete='off', labelText='Authorization Grant Type(s)', required='true', extraClass='tagify--custom-dropdown', initialValue=rcAuthGrantTypesCsv, formName='addClientForm') }}
        {{ errorableInput(type='text', name='scopes', id='scopes', autocomplete='off', labelText='Scope(s)', required='true', extraClass='tagify--custom-dropdown', initialValue=rcScopesCsv, formName='addClientForm') }}
        {{ errorableInput(type='text', name='redirectUris', id='redirectUris', autocomplete='off', labelText='Redirect URI(s)', required='true', extraClass='tagify--custom-dropdown', initialValue=rcRedirectUrisCsv, formName='addClientForm') }}
        {{ errorableInput(type='text', name='postLogoutRedirectUris', id='postLogoutRedirectUris', autocomplete='off', labelText='Post-Logout Redirect URI(s)', required='true', extraClass='tagify--custom-dropdown', initialValue=rcPostLogoutRedirectUrisCsv, formName='addClientForm') }}
        {{ errorableNumericInput(name='accessTokenTimeToLiveSeconds', id='accessTokenTimeToLiveSeconds', initialValue=registeredClient.tokenSettings.accessTokenTimeToLive.toSeconds(), min='1', max='999999999', labelText='Access Token TTL Seconds', formName='addClientForm') }}
        {{ errorableNumericInput(name='refreshTokenTimeToLiveSeconds', id='refreshTokenTimeToLiveSeconds', initialValue=registeredClient.tokenSettings.refreshTokenTimeToLive.toSeconds(), min='1', max='999999999', labelText='Refresh Token TTL Seconds', formName='addClientForm') }}
        {{ checkbox(name='requireProofKey', id='requireProofKey', labelText='Require Proof Key?', checked=registeredClient.clientSettings.requireProofKey) }}
        {{ checkbox(name='requireAuthorizationConsent', id='requireAuthorizationConsent', labelText='Require Authorization Consent?', checked=registeredClient.clientSettings.requireAuthorizationConsent) }}
        {{ checkbox(name='reuseRefreshTokens', id='reuseRefreshTokens', labelText='Reuse Refresh Tokens?', checked=registeredClient.tokenSettings.reuseRefreshTokens) }}
        {% include '../fragments/csrf' %}
        
        <div>
            <button type="submit"
                    class="flex w-full justify-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                Edit OAuth Client
            </button>
        </div>
    </form>
</div>
{% endblock %}

{% block preBodyEnd %}
<script src="{{ href('/oauth_client_tagify.js') }}"></script>
{% endblock %}
