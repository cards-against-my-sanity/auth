<!DOCTYPE html>
<html class="h-full bg-gray-50" lang="en">
<head>
    <title>{% block title %}Page Title{% endblock %} &mdash; InsanityID Admin</title>
    <link rel="stylesheet" href="{{ href('/main.css') }}" />
    {% block extraHead %}{% endblock %}
</head>
<body class="h-full">
<div class="flex min-h-full flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <h2 class="mt-6 text-center text-2xl/9 font-bold tracking-tight text-gray-900">{% block pageHeader %}Page Header{% endblock %}</h2>
    </div>

    <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-[960px]">
        <div class="bg-white px-6 py-12 shadow-sm sm:rounded-lg sm:px-12">
            {% include '../fragments/alert' %}
            {% block content %}<p>Page content</p>{% endblock %}
        </div>
    </div>
</div>
{% block preBodyEnd %}{% endblock %}
</body>
</html>